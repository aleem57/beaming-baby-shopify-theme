<style>
/* ─── ROOT VARS ─── */
#bbct-{{ section.id }} {
  --green:        #3a7d5e;
  --green-dk:     #2c6349;
  --green-lt:     #e8f5ee;
  --cream:        #f5f0e8;
  --white:        #ffffff;
  --border:       #e0dbd0;
  --text:         #2c3a2c;
  --muted:        #8a9a8a;
  --red:          #e05a44;
  --star:         #f59e0b;
  --radius:       10px;
  --radius-sm:    6px;
  --shadow:       0 2px 16px rgba(0,0,0,.08);
  --shadow-md:    0 8px 40px rgba(0,0,0,.14);
  /* Tier button colours */
  --btn-bronze:   #a0b08c;
  --btn-silver:   #d4623a;
  --btn-gold:     #2c6349;
  --btn-plat:     #d4623a;
  --btn-rsil:     #a0b08c;
  --btn-rgld:     #d4623a;
  /* Tier badge colours */
  --bdg-bronze-bg:#f5ede8; --bdg-bronze-fg:#8a9078;
  --bdg-silver-bg:#fde8e0; --bdg-silver-fg:#d4623a;
  --bdg-gold-bg:  #e8f0e8; --bdg-gold-fg:  #2c6349;
  --bdg-plat-bg:  #e8eef8; --bdg-plat-fg:  #5b73b0;
  --bdg-rsil-bg:  #e8f5ee; --bdg-rsil-fg:  #3a9078;
  --bdg-rgld-bg:  #fde8e0; --bdg-rgld-fg:  #d4623a;
  /* Table */
  --tbl-hdr-bg:   #f5f0e8;
  --tbl-shdr-bg:  #f0ebe0;
  --tbl-sep-bg:   #e8e0d0;
  --row-alt:      #faf8f4;
}

/* ─── SECTION WRAPPER ─── */
#bbct-{{ section.id }} {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text);
  background: var(--cream);
  padding: 48px 0 64px;
}

/* ─── HEADING ─── */
.bbct-heading {
  text-align: center;
  margin-bottom: 40px;
  padding: 0 20px;
}
.bbct-heading h2 {
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: 800;
  color: var(--green-dk);
  margin: 0 0 12px;
  line-height: 1.2;
}
.bbct-heading p {
  font-size: 1rem;
  color: var(--muted);
  margin: 0 auto;
  max-width: 560px;
  line-height: 1.6;
}

/* ─── CARDS ROW ─── */
.bbct-cards-wrap {
  display: flex;
  align-items: stretch;
  margin: 0 16px 32px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.bbct-cards-label {
  flex: 0 0 auto;
  writing-mode: vertical-rl;
  text-orientation: mixed;
  transform: rotate(180deg);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 20px 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1px solid var(--border);
  min-width: 32px;
  border-radius: var(--radius) 0 0 var(--radius);
}
.bbct-cards-inner {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
}
.bbct-card {
  background: var(--white);
  border-right: 1px solid var(--border);
  padding: 20px 12px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 6px;
  min-width: 155px;
  flex: 1 1 0;
  position: relative;
}
.bbct-card:last-child { border-right: none; }
.bbct-card.card-popular {
  outline: 2px solid var(--green-dk);
  outline-offset: -2px;
  z-index: 1;
}
.bbct-popular-banner {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: var(--green-dk);
  color: #fff;
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 0;
  text-align: center;
}
.bbct-card-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 3px 8px;
  border-radius: 20px;
  margin-top: 4px;
}
.card-popular .bbct-card-badge { margin-top: 18px; }
.card-bronze .bbct-card-badge { background: var(--bdg-bronze-bg); color: var(--bdg-bronze-fg); }
.card-silver .bbct-card-badge { background: var(--bdg-silver-bg); color: var(--bdg-silver-fg); }
.card-gold   .bbct-card-badge { background: var(--bdg-gold-bg);   color: var(--bdg-gold-fg); }
.card-plat   .bbct-card-badge { background: var(--bdg-plat-bg);   color: var(--bdg-plat-fg); }
.card-rsil   .bbct-card-badge { background: var(--bdg-rsil-bg);   color: var(--bdg-rsil-fg); }
.card-rgld   .bbct-card-badge { background: var(--bdg-rgld-bg);   color: var(--bdg-rgld-fg); }
.bbct-card-img {
  width: 82px; height: 72px;
  object-fit: contain; border-radius: 6px;
}
.bbct-card-img-ph {
  width: 82px; height: 72px;
  background: var(--row-alt);
  border-radius: 6px;
  border: 1px dashed var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem;
}
.bbct-card-name {
  font-size: 0.8rem; font-weight: 700;
  color: var(--text); line-height: 1.3;
}
.bbct-card-rating {
  font-size: 0.68rem; color: var(--muted); line-height: 1.4;
}
.bbct-card-stars { color: var(--star); letter-spacing: -1px; }
.bbct-card-prices {
  display: flex; align-items: baseline;
  justify-content: center; gap: 5px; flex-wrap: wrap;
}
.bbct-card-was {
  font-size: 0.72rem; color: var(--muted);
  text-decoration: line-through;
}
.bbct-card-now {
  font-size: 1.15rem; font-weight: 800; color: var(--red);
}
.bbct-atc-btn {
  width: 100%; padding: 8px 10px;
  font-size: 0.65rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.05em;
  border: none; border-radius: var(--radius-sm);
  cursor: pointer; color: #fff; margin-top: auto;
  transition: opacity .15s, transform .1s;
}
.bbct-atc-btn:hover  { opacity: .87; transform: translateY(-1px); }
.bbct-atc-btn:active { transform: translateY(0); }
.card-bronze .bbct-atc-btn { background: var(--btn-bronze); }
.card-silver .bbct-atc-btn { background: var(--btn-silver); }
.card-gold   .bbct-atc-btn { background: var(--btn-gold); }
.card-plat   .bbct-atc-btn { background: var(--btn-plat); }
.card-rsil   .bbct-atc-btn { background: var(--btn-rsil); }
.card-rgld   .bbct-atc-btn { background: var(--btn-rgld); }

/* ─── COMPARISON TABLE ─── */
.bbct-tbl-wrap {
  margin: 0 16px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  background: var(--white);
}
.bbct-tbl {
  width: 100%; min-width: 860px;
  border-collapse: collapse; font-size: 0.78rem;
}
.bbct-tbl-groups th {
  background: var(--tbl-hdr-bg);
  padding: 10px 8px; text-align: center;
  font-size: 0.62rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
}
.bbct-tbl-groups th:last-child { border-right: none; }
.bbct-tbl-shdr th {
  background: var(--tbl-shdr-bg);
  padding: 9px 8px; font-size: 0.62rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text); text-align: center;
  border-top: 2px solid var(--tbl-sep-bg);
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
  line-height: 1.3;
}
.bbct-tbl-shdr th:last-child { border-right: none; }
.bbct-tbl-shdr th:first-child {
  text-align: left; font-size: 0.65rem;
  color: var(--green-dk); background: var(--tbl-sep-bg);
  padding-left: 14px;
}
.bbct-tbl-shdr th:nth-child(2) {
  text-align: left; font-size: 0.62rem; color: var(--muted);
}
.bbct-tbl tbody tr.bbct-tbl-row { border-bottom: 1px solid var(--border); }
.bbct-tbl tbody tr.bbct-tbl-row:last-child { border-bottom: none; }
.bbct-tbl tbody tr.bbct-tbl-row:nth-child(even) td { background: var(--row-alt); }
.bbct-tbl td {
  padding: 12px 8px; text-align: center;
  border-right: 1px solid var(--border);
  vertical-align: middle; color: var(--text);
}
.bbct-tbl td:last-child { border-right: none; }
.bbct-tbl td:first-child {
  text-align: left; font-weight: 600; padding-left: 14px;
}
.bbct-tbl td:nth-child(2) { text-align: left; min-width: 80px; }
.bbct-td-was { display: block; font-size: 0.68rem; color: var(--muted); text-decoration: line-through; line-height: 1; margin-bottom: 2px; }
.bbct-td-now { display: block; font-size: 0.88rem; font-weight: 800; color: var(--red); line-height: 1; }
.bbct-td-num { font-weight: 700; font-size: 0.88rem; color: var(--text); }
.bbct-td-dash { color: var(--muted); font-size: 0.9rem; }
.ico-check {
  display: inline-flex; align-items: center; justify-content: center;
  width: 22px; height: 22px; border-radius: 50%;
  background: #3a7d5e; color: #fff; font-size: 0.65rem; font-weight: 700;
}
.ico-cross {
  display: inline-flex; align-items: center; justify-content: center;
  width: 22px; height: 22px; border-radius: 50%;
  background: #e05a44; color: #fff; font-size: 0.65rem; font-weight: 700;
}

/* ─── MODAL ─── */
.bbct-modal-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,.55); z-index: 9999;
  align-items: center; justify-content: center; padding: 16px;
}
.bbct-modal-overlay.open { display: flex; }
.bbct-modal {
  background: var(--white); border-radius: var(--radius);
  padding: 28px 24px 24px; max-width: 440px; width: 100%;
  box-shadow: var(--shadow-md); position: relative;
  max-height: 90vh; overflow-y: auto;
}
.bbct-modal-close {
  position: absolute; top: 14px; right: 16px;
  background: none; border: none; font-size: 1.4rem;
  cursor: pointer; color: var(--muted); line-height: 1; padding: 0;
}
.bbct-modal-close:hover { color: var(--text); }
.bbct-modal-product { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: 4px; }
.bbct-modal-title { font-size: 1.15rem; font-weight: 700; color: var(--text); margin: 0 0 16px; }
.bbct-msz-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 20px; }
.bbct-msz-btn {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 10px 8px;
  border: 2px solid var(--border); border-radius: var(--radius-sm);
  background: var(--white); font-size: 0.8rem; font-weight: 600;
  cursor: pointer; transition: border-color .15s, background .15s;
  text-align: center; gap: 4px;
}
.bbct-msz-btn:hover   { border-color: var(--green); background: var(--green-lt); }
.bbct-msz-btn.selected { border-color: var(--green); background: var(--green-lt); color: var(--green-dk); }
.bbct-msz-btn.unavail { opacity: .4; cursor: not-allowed; text-decoration: line-through; }
.bbct-msz-swatch {
  display: inline-block; width: 16px; height: 16px;
  border-radius: 50%; margin-bottom: 4px;
  border: 2px solid rgba(255,255,255,0.6);
  box-shadow: 0 0 0 1px rgba(0,0,0,.15);
}
.bbct-modal-price { font-size: 1rem; font-weight: 700; color: var(--green-dk); margin-bottom: 16px; }
.bbct-modal-atc {
  width: 100%; padding: 13px 18px; background: var(--green);
  color: #fff; border: none; border-radius: var(--radius-sm);
  font-size: 0.95rem; font-weight: 700;
  cursor: pointer; transition: background .15s, transform .1s;
}
.bbct-modal-atc:hover  { background: var(--green-dk); }
.bbct-modal-atc:active { transform: scale(.98); }
.bbct-modal-atc:disabled { background: var(--border); color: var(--muted); cursor: not-allowed; }
.bbct-modal-notice { font-size: 0.75rem; color: var(--muted); text-align: center; margin-top: 10px; }
.bbct-modal-success { display: none; text-align: center; padding: 16px 0; }
.bbct-modal-success.show { display: block; }
.bbct-modal-success-icon { font-size: 2.5rem; margin-bottom: 8px; }
.bbct-modal-success h3 { font-size: 1.1rem; font-weight: 700; color: var(--green-dk); margin: 0 0 6px; }
.bbct-modal-success p  { font-size: 0.85rem; color: var(--muted); margin: 0; }

/* ─── MOBILE TABS ─── */
.bbct-mob { display: none; margin: 0 12px 32px; }
.bbct-mob-tabs { display: flex; overflow-x: auto; gap: 8px; padding-bottom: 4px; -webkit-overflow-scrolling: touch; }
.bbct-mob-tab { flex: 0 0 auto; padding: 8px 16px; border: 2px solid var(--border); border-radius: 20px; background: var(--white); font-size: 0.8rem; font-weight: 600; cursor: pointer; white-space: nowrap; transition: border-color .15s, color .15s; }
.bbct-mob-tab.active { border-color: var(--green); color: var(--green); background: var(--green-lt); }
.bbct-mob-panels { margin-top: 12px; }
.bbct-mob-panel  { display: none; }
.bbct-mob-panel.active { display: block; }
.bbct-mob-card {
  background: var(--white); border-radius: var(--radius);
  box-shadow: var(--shadow); padding: 20px 16px;
  display: flex; flex-direction: column; gap: 10px;
  border-top: 4px solid var(--border);
}
.bbct-mob-card.card-bronze { border-top-color: var(--btn-bronze); }
.bbct-mob-card.card-silver { border-top-color: var(--btn-silver); }
.bbct-mob-card.card-gold   { border-top-color: var(--btn-gold); }
.bbct-mob-card.card-plat   { border-top-color: var(--btn-plat); }
.bbct-mob-card.card-rsil   { border-top-color: var(--btn-rsil); }
.bbct-mob-card.card-rgld   { border-top-color: var(--btn-rgld); }
.bbct-mob-name  { font-size: 1rem; font-weight: 700; color: var(--text); }
.bbct-mob-price { font-size: 1.3rem; font-weight: 800; color: var(--red); }
.bbct-mob-was   { font-size: 0.8rem; color: var(--muted); text-decoration: line-through; }
.bbct-mob-save  { font-size: 0.75rem; font-weight: 700; color: var(--red); }
.bbct-mob-features { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.bbct-mob-features li { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .bbct-cards-wrap { display: none; }
  .bbct-tbl-wrap   { display: none; }
  .bbct-mob        { display: block; }
}
@media (min-width: 769px) { .bbct-mob { display: none; } }
</style>
{% comment %} ── SECTION HTML ── {% endcomment %}
<section id="bbct-{{ section.id }}" aria-label="Bundle comparison table">

  <div class="bbct-heading">
    <h2>{{ section.settings.heading | default: "Try more for less — £20 off our essential bundles" }}</h2>
    <p>{{ section.settings.subheading | default: "Explore our carefully selected bundles and enjoy exceptional value on gentle products made without harsh chemicals, parabens or unnecessary additives." }}</p>
  </div>

  {% comment %} ──────────────────────────────────
    PRODUCT CARDS ROW
    data-is-colour="true"  → opens colour picker (Reusables Silver / Gold)
    data-is-colour="false" → opens size picker  (Disposable tiers)
  ────────────────────────────────── {% endcomment %}
  <div class="bbct-cards-wrap">
    <div class="bbct-cards-label">Compare Bundles</div>
    <div class="bbct-cards-inner">

      {% comment %} ── Bronze ── {% endcomment %}
      <div class="bbct-card card-bronze"
        data-tier="bronze" data-name="Bronze Bundle" data-price-p="2325"
        data-one-size="false" data-is-colour="false"
        data-vid0="REPLACE_VID_BRONZE_S1" data-vid1="REPLACE_VID_BRONZE_S2"
        data-vid2="REPLACE_VID_BRONZE_S3" data-vid3="REPLACE_VID_BRONZE_S4"
        data-vid4="REPLACE_VID_BRONZE_S5" data-vid5="REPLACE_VID_BRONZE_S6"
        data-avail0="true" data-avail1="true" data-avail2="true"
        data-avail3="true" data-avail4="true" data-avail5="true"
      >
        <span class="bbct-card-badge">🏅 Bronze</span>
        {% if section.settings.bronze_image %}
          {{ section.settings.bronze_image | image_url: width: 200 | image_tag: class: 'bbct-card-img', alt: 'Bronze Bundle' }}
        {% else %}
          <div class="bbct-card-img-ph">📦</div>
        {% endif %}
        <div class="bbct-card-name">Bronze Bundle</div>
        <div class="bbct-card-rating">
          <span class="bbct-card-stars">★★★★★</span><br>4.9 · Beaming Baby
        </div>
        <div class="bbct-card-prices">
          <span class="bbct-card-was">£43.25</span>
          <span class="bbct-card-now">£23.25</span>
        </div>
        <button class="bbct-atc-btn" onclick="bbctOpen(this.closest('.bbct-card'))">Choose Size</button>
      </div>

      {% comment %} ── Silver ── {% endcomment %}
      <div class="bbct-card card-silver"
        data-tier="silver" data-name="Silver Bundle" data-price-p="3326"
        data-one-size="false" data-is-colour="false"
        data-vid0="REPLACE_VID_SILVER_S1" data-vid1="REPLACE_VID_SILVER_S2"
        data-vid2="REPLACE_VID_SILVER_S3" data-vid3="REPLACE_VID_SILVER_S4"
