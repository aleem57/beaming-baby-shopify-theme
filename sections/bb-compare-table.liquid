<script>
(function () {
  'use strict';

  /* ─── Colour picker data ─── */
  var COLOURS = [
    { name: 'Blue',      hex: '#4a90d9' },
    { name: 'Green',     hex: '#3a7d5e' },
    { name: 'Pink',      hex: '#e879a0' },
    { name: 'Turquoise', hex: '#0d9488' },
    { name: 'Yellow',    hex: '#f59e0b' }
  ];

  /* ─── Size picker data ─── */
  var SIZES = ['Size 1', 'Size 2', 'Size 3', 'Size 4', 'Size 5', 'Size 6'];

  /* ─── Format pence → £ string ─── */
  function fmtPrice(pence) {
    return '£' + (pence / 100).toFixed(2);
  }

  /* ─── Collect variant IDs + availability from card element ─── */
  function getVariants(card) {
    var vids = [], avails = [];
    for (var i = 0; i <= 5; i++) {
      var vid   = card.dataset['vid'   + i];
      var avail = card.dataset['avail' + i];
      if (vid !== undefined) {
        vids.push(vid);
        avails.push(avail !== 'false');
      }
    }
    return { vids: vids, avails: avails };
  }

  /* ─── Find the section ID from ancestor ─── */
  function getSectionId(card) {
    var sec = card.closest('section[id^="bbct-"]');
    return sec ? sec.id.replace('bbct-', '') : '';
  }

  /* ─────────────────────────────────────────────────
     bbctOpen(card)
     Called when a "Choose Size" / "Choose Colour" button is clicked.
     card = the .bbct-card or .bbct-mob-card element.
  ───────────────────────────────────────────────── */
  window.bbctOpen = function (card) {
    var sid      = getSectionId(card);
    var overlay  = document.getElementById('bbct-modal-' + sid);
    var body     = document.getElementById('bbct-modal-body-' + sid);
    var success  = document.getElementById('bbct-modal-success-' + sid);
    if (!overlay || !body) return;

    var d        = card.dataset;
    var name     = d.name     || 'Product';
    var priceP   = parseInt(d.priceP || '0', 10);
    var isColour = d.isColour === 'true';
    var variants = getVariants(card);

    /* Reset success state */
    success.classList.remove('show');
    body.style.display = '';

    /* ── Build modal body HTML ── */
    var html = '';

    /* Product label */
    html += '<div class="bbct-modal-product">' + escHtml(name) + '</div>';

    /* Modal title — "Select your colour:" or "Select your nappy size:" */
    if (isColour) {
      html += '<h2 class="bbct-modal-title" id="bbct-modal-title-' + sid + '">Select your colour:</h2>';
    } else {
      html += '<h2 class="bbct-modal-title" id="bbct-modal-title-' + sid + '">Select your nappy size:</h2>';
    }

    /* Price */
    html += '<div class="bbct-modal-price">' + fmtPrice(priceP) + '</div>';

    /* Variant buttons */
    html += '<div class="bbct-msz-grid">';

    for (var i = 0; i < variants.vids.length; i++) {
      var vid     = variants.vids[i];
      var avail   = variants.avails[i];
      var unavailClass = avail ? '' : ' unavail';

      if (isColour) {
        /* Colour variant button with swatch */
        var col = COLOURS[i] || { name: 'Colour ' + (i + 1), hex: '#aaa' };
        html +=
          '<button class="bbct-msz-btn' + unavailClass + '" ' +
                  'data-vid="' + escAttr(vid) + '" ' +
                  'data-label="' + escAttr(col.name) + '" ' +
                  (avail ? '' : 'disabled ') +
                  'onclick="bbctSelectVariant(this)">' +
            '<span class="bbct-msz-swatch" style="background:' + col.hex + '"></span>' +
            escHtml(col.name) +
          '</button>';
      } else {
        /* Size variant button */
        var sizeLabel = SIZES[i] || ('Size ' + (i + 1));
        html +=
          '<button class="bbct-msz-btn' + unavailClass + '" ' +
                  'data-vid="' + escAttr(vid) + '" ' +
                  'data-label="' + escAttr(sizeLabel) + '" ' +
                  (avail ? '' : 'disabled ') +
                  'onclick="bbctSelectVariant(this)">' +
            escHtml(sizeLabel) +
          '</button>';
      }
    }

    html += '</div>'; /* /.bbct-msz-grid */

    /* ATC button — disabled until a variant is selected */
    if (isColour) {
      html +=
        '<button class="bbct-modal-atc" id="bbct-atc-' + sid + '" disabled ' +
                'onclick="bbctAddToCart(\'' + sid + '\')">' +
          'Add to Bag' +
        '</button>';
    } else {
      html +=
        '<button class="bbct-modal-atc" id="bbct-atc-' + sid + '" disabled ' +
                'onclick="bbctAddToCart(\'' + sid + '\')">' +
          'Add to Bag' +
        '</button>';
    }

    html += '<p class="bbct-modal-notice">Free UK delivery on all subscription orders.</p>';

    body.innerHTML = html;

    /* Store whether this is a colour picker for ATC labelling */
    overlay.dataset.isColour = isColour ? 'true' : 'false';

    /* Open overlay */
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  /* ─────────────────────────────────────────────────
     bbctSelectVariant(btn)
     Called when a size or colour button is clicked.
  ───────────────────────────────────────────────── */
  window.bbctSelectVariant = function (btn) {
    var grid = btn.closest('.bbct-msz-grid');
    if (!grid) return;

    /* Deselect siblings */
    grid.querySelectorAll('.bbct-msz-btn').forEach(function (b) {
      b.classList.remove('selected');
    });
    btn.classList.add('selected');

    /* Update ATC button */
    var overlay = btn.closest('.bbct-modal-overlay');
    if (!overlay) return;
    var sid = overlay.id.replace('bbct-modal-', '');
    var atcBtn = document.getElementById('bbct-atc-' + sid);
    if (!atcBtn) return;

    var label    = btn.dataset.label || '';
    var vid      = btn.dataset.vid   || '';
    var isColour = overlay.dataset.isColour === 'true';

    atcBtn.disabled = false;
    atcBtn.dataset.selectedVid = vid;

    if (isColour) {
      atcBtn.textContent = 'Add to Bag \u2014 ' + label;
    } else {
      atcBtn.textContent = 'Add to Bag \u2014 ' + label;
    }
  };

  /* ─────────────────────────────────────────────────
     bbctAddToCart(sid)
     Posts the selected variant to Shopify /cart/add.js
  ───────────────────────────────────────────────── */
  window.bbctAddToCart = function (sid) {
    var atcBtn = document.getElementById('bbct-atc-' + sid);
    if (!atcBtn || atcBtn.disabled) return;

    var vid = atcBtn.dataset.selectedVid;
    if (!vid) return;

    atcBtn.disabled    = true;
    atcBtn.textContent = 'Adding\u2026';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: vid, quantity: 1 })
    })
    .then(function (res) {
      if (!res.ok) throw new Error('Cart error ' + res.status);
      return res.json();
    })
    .then(function () {
      var body    = document.getElementById('bbct-modal-body-' + sid);
      var success = document.getElementById('bbct-modal-success-' + sid);
      if (body)    body.style.display = 'none';
      if (success) success.classList.add('show');
      /* Refresh cart count if theme exposes a method */
      if (typeof window.Shopify !== 'undefined' && typeof window.Shopify.onCartUpdate === 'function') {
        fetch('/cart.js').then(function(r){ return r.json(); }).then(window.Shopify.onCartUpdate);
      }
    })
    .catch(function (err) {
      console.error('[bbct] Add to cart failed:', err);
      atcBtn.disabled    = false;
      atcBtn.textContent = 'Error — try again';
    });
  };

  /* ─────────────────────────────────────────────────
     bbctClose(sid)
     Closes the modal overlay.
  ───────────────────────────────────────────────── */
  window.bbctClose = function (sid) {
    var overlay = document.getElementById('bbct-modal-' + sid);
    if (!overlay) return;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  };

  /* ─── Close on backdrop click ─── */
  document.addEventListener('click', function (e) {
    if (e.target.classList.contains('bbct-modal-overlay')) {
      e.target.classList.remove('open');
      document.body.style.overflow = '';
    }
  });

  /* ─── Close on Escape key ─── */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.bbct-modal-overlay.open').forEach(function (o) {
        o.classList.remove('open');
        document.body.style.overflow = '';
      });
    }
  });

  /* ─────────────────────────────────────────────────
     bbctMobTab(tab, panelId)
     Switches the active mobile tab and panel.
  ───────────────────────────────────────────────── */
  window.bbctMobTab = function (tab, panelId) {
    var tabBar = tab.closest('.bbct-mob-tabs');
    if (tabBar) {
      tabBar.querySelectorAll('.bbct-mob-tab').forEach(function (t) {
        t.classList.remove('active');
      });
      tab.classList.add('active');
    }
    var panels = tab.closest('.bbct-mob').querySelectorAll('.bbct-mob-panel');
    panels.forEach(function (p) { p.classList.remove('active'); });
    var target = document.getElementById(panelId);
    if (target) target.classList.add('active');
  };

  /* ─── Utility: escape HTML entities ─── */
  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /* ─── Utility: escape attribute values ─── */
  function escAttr(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;');
  }

})();
</script>

