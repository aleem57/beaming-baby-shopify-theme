<style>
/* ─── ROOT VARS ─── */
#bbct-{{ section.id }} {
  --green:         #3a7d5e;
  --green-dk:      #2c6349;
  --green-lt:      #e8f5ee;
  --cream:         #f7f5f0;
  --white:         #ffffff;
  --border:        #e2e8e2;
  --text:          #1a2e1a;
  --muted:         #6b7a6b;
  --bronze:        #a0b08c;
  --bronze-lt:     #fdf0ea;
  --silver:        #ea6d4e;
  --silver-lt:     #e8f1f7;
  --gold:          #a0b08c;
  --gold-lt:       #fdf0ea;
  --platinum:      #ea6d4e;
  --platinum-lt:   #e8f1f7;
  --reusable-sml:  #a0b08c;
  --reusable-sml-lt: #fdf0ea;
  --reusable-lge:  #ea6d4e;
  --reusable-lge-lt: #e8f1f7;
  --red:           #e05a44;
  --star:          #f59e0b;
  --check:         #3a7d5e;
  --row-alt:       #f9faf9;
  --shadow:        0 4px 24px rgba(26,46,26,.08);
  --shadow-md:     0 8px 40px rgba(26,46,26,.14);
  --radius:        12px;
  --radius-sm:     8px;
}

/* ─── SECTION WRAPPER ─── */
#bbct-{{ section.id }} {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text);
  background: var(--cream);
  padding: 48px 0 64px;
}

/* ─── HEADINGS ─── */
.bbct-heading {
  text-align: center;
  margin-bottom: 36px;
  padding: 0 16px;
}
.bbct-heading h2 {
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 700;
  color: var(--green-dk);
  margin: 0 0 8px;
}
.bbct-heading p {
  font-size: 1.05rem;
  color: var(--muted);
  margin: 0;
}

/* ─── DESKTOP SCROLL ─── */
.bbct-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 8px;
}
.bbct-cols {
  display: grid;
  grid-template-columns: 200px repeat(6, minmax(160px, 1fr));
  min-width: 900px;
  gap: 0;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  margin: 0 16px 32px;
}

/* label column */
.bbct-label-col {
  background: var(--white);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}
.bbct-label-col .bbct-feature-label {
  padding: 14px 16px;
  font-size: 0.825rem;
  color: var(--muted);
  font-weight: 500;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  min-height: 48px;
}
.bbct-label-col .bbct-feature-label:first-child {
  min-height: 220px;
  align-items: flex-end;
  font-size: 0.75rem;
  color: transparent;
}

/* product column header card */
.bbct-col {
  background: var(--white);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}
.bbct-col:last-child { border-right: none; }

.bbct-card {
  padding: 20px 14px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-bottom: 3px solid var(--border);
  min-height: 220px;
  justify-content: flex-start;
  gap: 6px;
  position: relative;
}
.bbct-card.tier-bronze     { border-bottom-color: var(--bronze); }
.bbct-card.tier-silver     { border-bottom-color: var(--silver); }
.bbct-card.tier-gold       { border-bottom-color: var(--gold); }
.bbct-card.tier-platinum   { border-bottom-color: var(--platinum); }
.bbct-card.tier-rsil       { border-bottom-color: var(--reusable-sml); }
.bbct-card.tier-rgld       { border-bottom-color: var(--reusable-lge); }

.bbct-badge {
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  padding: 3px 8px;
  border-radius: 20px;
  margin-bottom: 4px;
}
.tier-bronze   .bbct-badge { background: var(--bronze-lt);       color: var(--bronze); }
.tier-silver   .bbct-badge { background: var(--silver-lt);       color: var(--silver); }
.tier-gold     .bbct-badge { background: var(--gold-lt);         color: var(--gold); }
.tier-platinum .bbct-badge { background: var(--platinum-lt);     color: var(--platinum); }
.tier-rsil     .bbct-badge { background: var(--reusable-sml-lt); color: var(--reusable-sml); }
.tier-rgld     .bbct-badge { background: var(--reusable-lge-lt); color: var(--reusable-lge); }

.bbct-card-name {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}
.bbct-card-price {
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--green-dk);
  line-height: 1;
}
.bbct-card-was {
  font-size: 0.75rem;
  color: var(--muted);
  text-decoration: line-through;
}
.bbct-card-save {
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--red);
  background: #fef2f2;
  padding: 2px 6px;
  border-radius: 4px;
}
.bbct-stars {
  color: var(--star);
  font-size: 0.75rem;
  letter-spacing: -1px;
}
.bbct-atc-btn {
  display: inline-block;
  width: 100%;
  margin-top: auto;
  padding: 9px 10px;
  font-size: 0.75rem;
  font-weight: 700;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: opacity .15s, transform .1s;
  text-align: center;
}
.bbct-atc-btn:hover  { opacity: .88; transform: translateY(-1px); }
.bbct-atc-btn:active { transform: translateY(0); }
.tier-bronze   .bbct-atc-btn { background: var(--bronze);       color: #fff; }
.tier-silver   .bbct-atc-btn { background: var(--silver);       color: #fff; }
.tier-gold     .bbct-atc-btn { background: var(--gold);         color: #fff; }
.tier-platinum .bbct-atc-btn { background: var(--platinum);     color: #fff; }
.tier-rsil     .bbct-atc-btn { background: var(--reusable-sml); color: #fff; }
.tier-rgld     .bbct-atc-btn { background: var(--reusable-lge); color: #fff; }

/* feature value cells */
.bbct-cell {
  padding: 14px 12px;
  font-size: 0.825rem;
  text-align: center;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
}
.bbct-col:nth-child(odd) .bbct-cell { background: var(--row-alt); }
.bbct-cell .check { color: var(--check); font-size: 1rem; }
.bbct-cell .cross  { color: #ccc; font-size: 1rem; }
.bbct-cell-text   { color: var(--text); font-weight: 600; font-size: 0.775rem; }

/* ─── COMPARISON GRID WRAP ─── */
.bbct-grid-wrap {
  margin: 0 16px;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  background: var(--white);
}
.bbct-grid-hdr {
  display: grid;
  grid-template-columns: 200px repeat(6, 1fr);
  background: var(--green-dk);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .04em;
  min-width: 900px;
}
.bbct-grid-hdr-cell {
  padding: 12px 10px;
  text-align: center;
  border-right: 1px solid rgba(255,255,255,.15);
}
.bbct-grid-hdr-cell:last-child { border-right: none; }
.bbct-grid-hdr-cell:first-child { text-align: left; }

.bbct-grid-row {
  display: grid;
  grid-template-columns: 200px repeat(6, 1fr);
  border-top: 1px solid var(--border);
  min-width: 900px;
}
.bbct-grid-row:nth-child(even) { background: var(--row-alt); }
.bbct-grid-cell {
  padding: 13px 10px;
  font-size: 0.825rem;
  text-align: center;
  border-right: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bbct-grid-cell:last-child { border-right: none; }
.bbct-grid-cell:first-child {
  text-align: left;
  justify-content: flex-start;
  font-weight: 600;
  color: var(--text);
}
.bbct-grid-cell .check { color: var(--check); }
.bbct-grid-cell .cross  { color: #ccc; }
.bbct-grid-price {
  font-weight: 700;
  color: var(--green-dk);
  font-size: 0.875rem;
}
.bbct-grid-was {
  font-size: 0.7rem;
  color: var(--muted);
  text-decoration: line-through;
  display: block;
}

/* ─── MOBILE TABS ─── */
.bbct-mob {
  display: none;
  margin: 0 12px 32px;
}
.bbct-mob-tabs {
  display: flex;
  overflow-x: auto;
  gap: 8px;
  padding-bottom: 4px;
  -webkit-overflow-scrolling: touch;
}
.bbct-mob-tab {
  flex: 0 0 auto;
  padding: 8px 16px;
  border: 2px solid var(--border);
  border-radius: 20px;
  background: var(--white);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color .15s, color .15s;
}
.bbct-mob-tab.active {
  border-color: var(--green);
  color: var(--green);
  background: var(--green-lt);
}
.bbct-mob-panels { margin-top: 12px; }
.bbct-mob-panel  { display: none; }
.bbct-mob-panel.active { display: block; }

.bbct-mob-card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  border-top: 4px solid var(--border);
}
.bbct-mob-card.tier-bronze   { border-top-color: var(--bronze); }
.bbct-mob-card.tier-silver   { border-top-color: var(--silver); }
.bbct-mob-card.tier-gold     { border-top-color: var(--gold); }
.bbct-mob-card.tier-platinum { border-top-color: var(--platinum); }
.bbct-mob-card.tier-rsil     { border-top-color: var(--reusable-sml); }
.bbct-mob-card.tier-rgld     { border-top-color: var(--reusable-lge); }

.bbct-mob-name  { font-size: 1rem; font-weight: 700; color: var(--text); }
.bbct-mob-price { font-size: 1.3rem; font-weight: 800; color: var(--green-dk); }
.bbct-mob-was   { font-size: 0.8rem; color: var(--muted); text-decoration: line-through; }
.bbct-mob-save  { font-size: 0.75rem; font-weight: 700; color: var(--red); }
.bbct-mob-features {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.bbct-mob-features li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
}
.bbct-mob-features li .check { color: var(--check); }
.bbct-mob-features li .cross  { color: #ccc; }

/* ─── MODAL ─── */
.bbct-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.55);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.bbct-modal-overlay.open { display: flex; }
.bbct-modal {
  background: var(--white);
  border-radius: var(--radius);
  padding: 28px 24px 24px;
  max-width: 440px;
  width: 100%;
  box-shadow: var(--shadow-md);
  position: relative;
  max-height: 90vh;
  overflow-y: auto;
}
.bbct-modal-close {
  position: absolute;
  top: 14px;
  right: 16px;
  background: none;
  border: none;
  font-size: 1.4rem;
  cursor: pointer;
  color: var(--muted);
  line-height: 1;
  padding: 0;
}
.bbct-modal-close:hover { color: var(--text); }
.bbct-modal-product {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--muted);
  margin-bottom: 4px;
}
.bbct-modal-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 16px;
}
.bbct-msz-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 20px;
}
.bbct-msz-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10px 8px;
  border: 2px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--white);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: border-color .15s, background .15s;
  text-align: center;
  gap: 4px;
}
.bbct-msz-btn:hover   { border-color: var(--green); background: var(--green-lt); }
.bbct-msz-btn.selected {
  border-color: var(--green);
  background: var(--green-lt);
  color: var(--green-dk);
}
.bbct-msz-btn.unavail {
  opacity: .4;
  cursor: not-allowed;
  text-decoration: line-through;
}
/* ─── COLOUR SWATCH ─── */
.bbct-msz-swatch {
  display: inline-block;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  margin-bottom: 4px;
  border: 2px solid rgba(255,255,255,0.6);
  box-shadow: 0 0 0 1px rgba(0,0,0,.15);
}
.bbct-modal-price {
  font-size: 1rem;
  font-weight: 700;
  color: var(--green-dk);
  margin-bottom: 16px;
}
.bbct-modal-atc {
  width: 100%;
  padding: 13px 18px;
  background: var(--green);
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: background .15s, transform .1s;
}
.bbct-modal-atc:hover  { background: var(--green-dk); }
.bbct-modal-atc:active { transform: scale(.98); }
.bbct-modal-atc:disabled {
  background: var(--border);
  color: var(--muted);
  cursor: not-allowed;
}
.bbct-modal-notice {
  font-size: 0.75rem;
  color: var(--muted);
  text-align: center;
  margin-top: 10px;
}
/* ─── SUCCESS STATE ─── */
.bbct-modal-success {
  display: none;
  text-align: center;
  padding: 16px 0;
}
.bbct-modal-success.show { display: block; }
.bbct-modal-success-icon { font-size: 2.5rem; margin-bottom: 8px; }
.bbct-modal-success h3   { font-size: 1.1rem; font-weight: 700; color: var(--green-dk); margin: 0 0 6px; }
.bbct-modal-success p    { font-size: 0.85rem; color: var(--muted); margin: 0; }
.bbct-modal-body {}

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .bbct-scroll     { display: none; }
  .bbct-grid-wrap  { display: none; }
  .bbct-mob        { display: block; }
}
@media (min-width: 769px) {
  .bbct-mob { display: none; }
}
</style>

{% comment %} ── SECTION HTML ── {% endcomment %}
<section id="bbct-{{ section.id }}" aria-label="Product comparison table">

  {% comment %} ── Heading ── {% endcomment %}
  <div class="bbct-heading">
    <h2>{{ section.settings.heading | default: "Compare Our Nappy Ranges" }}</h2>
    <p>{{ section.settings.subheading | default: "Find the perfect fit for your baby and your lifestyle" }}</p>
  </div>

  {% comment %} ──────────────────────────────────
    DESKTOP COMPARISON TABLE (.bbct-scroll)
    Each product column (th) carries data-* attributes
    consumed by bbctOpen() to build the modal.

    data-tier        : tier key
    data-name        : display name
    data-price-p     : price in pence
    data-one-size    : "true" | "false"
    data-is-colour   : "true" (colour picker) | "false" (size picker)
    data-vid0–vid4/5 : Shopify variant IDs
    data-avail0–…    : "true" | "false" per variant
  ────────────────────────────────── {% endcomment %}

  <div class="bbct-scroll" role="region" aria-label="Product comparison — scroll horizontally">
    <div class="bbct-cols" role="table">

      {% comment %} ── Label column ── {% endcomment %}
      <div class="bbct-label-col" role="rowgroup">
        <div class="bbct-feature-label" role="columnheader">Features</div>
        <div class="bbct-feature-label">Monthly price</div>
        <div class="bbct-feature-label">Type</div>
        <div class="bbct-feature-label">Eco-certified</div>
        <div class="bbct-feature-label">Chemical-free</div>
        <div class="bbct-feature-label">Fragrance-free</div>
        <div class="bbct-feature-label">Chlorine-free bleach</div>
        <div class="bbct-feature-label">Biodegradable materials</div>
        <div class="bbct-feature-label">Organic cotton top-sheet</div>
        <div class="bbct-feature-label">Free from latex</div>
        <div class="bbct-feature-label">Hypoallergenic</div>
        <div class="bbct-feature-label">Dermatologically tested</div>
        <div class="bbct-feature-label">Suitable from birth</div>
        <div class="bbct-feature-label">Reusable</div>
      </div>

      {% comment %} ── BRONZE ── {% endcomment %}
      <div class="bbct-col" role="columnheader">
        <div class="bbct-card tier-bronze"
          data-tier="bronze"
          data-name="Bronze"
          data-price-p="1999"
          data-one-size="false"
          data-is-colour="false"
          data-vid0="REPLACE_VID_BRONZE_S1"
          data-vid1="REPLACE_VID_BRONZE_S2"
          data-vid2="REPLACE_VID_BRONZE_S3"
          data-vid3="REPLACE_VID_BRONZE_S4"
          data-vid4="REPLACE_VID_BRONZE_S5"
          data-vid5="REPLACE_VID_BRONZE_S6"
          data-avail0="true"
          data-avail1="true"
          data-avail2="true"
          data-avail3="true"
          data-avail4="true"
          data-avail5="true"
        >
          <span class="bbct-badge">Bronze</span>
          <span class="bbct-card-name">Eco Disposables<br>Bronze</span>
          <div class="bbct-stars">★★★☆☆</div>
          <div class="bbct-card-price">£19.99</div>
