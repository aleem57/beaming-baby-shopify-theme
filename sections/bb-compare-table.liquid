  {% comment %} ──────────────────────────────────
    SIZE / COLOUR PICKER MODAL
    Populated dynamically by bbctOpen()
  ────────────────────────────────── {% endcomment %}
  <div class="bbct-modal-overlay" id="bbct-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="bbct-modal-title-{{ section.id }}">
    <div class="bbct-modal">
      <button class="bbct-modal-close" onclick="bbctClose('{{ section.id }}')" aria-label="Close">&times;</button>
      <div class="bbct-modal-body" id="bbct-modal-body-{{ section.id }}"><!-- populated by bbctOpen() --></div>
      <div class="bbct-modal-success" id="bbct-modal-success-{{ section.id }}">
        <div class="bbct-modal-success-icon">&#127881;</div>
        <h3>Added to your bag!</h3>
        <p>Head to checkout when you're ready.</p>
      </div>
    </div>
  </div>

</section>
<script>
(function () {
  'use strict';

  var COLOURS = [
    { name: 'Blue',      hex: '#4a90d9' },
    { name: 'Green',     hex: '#3a7d5e' },
    { name: 'Pink',      hex: '#e879a0' },
    { name: 'Turquoise', hex: '#0d9488' },
    { name: 'Yellow',    hex: '#f59e0b' }
  ];
  var SIZES = ['Size 1', 'Size 2', 'Size 3', 'Size 4', 'Size 5', 'Size 6'];

  function fmtPrice(pence) { return '\u00a3' + (pence / 100).toFixed(2); }

  function getVariants(card) {
    var vids = [], avails = [];
    for (var i = 0; i <= 5; i++) {
      var vid = card.dataset['vid' + i];
      var av  = card.dataset['avail' + i];
      if (vid !== undefined) { vids.push(vid); avails.push(av !== 'false'); }
    }
    return { vids: vids, avails: avails };
  }

  function getSectionId(card) {
    var sec = card.closest('section[id^="bbct-"]');
    return sec ? sec.id.replace('bbct-', '') : '';
  }

  window.bbctOpen = function (card) {
    var sid     = getSectionId(card);
    var overlay = document.getElementById('bbct-modal-' + sid);
    var body    = document.getElementById('bbct-modal-body-' + sid);
    var success = document.getElementById('bbct-modal-success-' + sid);
    if (!overlay || !body) return;

    var d        = card.dataset;
    var name     = d.name   || 'Product';
    var priceP   = parseInt(d.priceP || '0', 10);
    var isColour = d.isColour === 'true';
    var variants = getVariants(card);

    success.classList.remove('show');
    body.style.display = '';

    var html = '';
    html += '<div class="bbct-modal-product">' + escHtml(name) + '</div>';
    html += '<h2 class="bbct-modal-title" id="bbct-modal-title-' + sid + '">' +
            (isColour ? 'Select your colour:' : 'Select your nappy size:') + '</h2>';
    html += '<div class="bbct-modal-price">' + fmtPrice(priceP) + '</div>';
    html += '<div class="bbct-msz-grid">';

    for (var i = 0; i < variants.vids.length; i++) {
      var vid   = variants.vids[i];
      var avail = variants.avails[i];
      var ucls  = avail ? '' : ' unavail';
      if (isColour) {
        var col = COLOURS[i] || { name: 'Colour ' + (i + 1), hex: '#aaa' };
        html += '<button class="bbct-msz-btn' + ucls + '" data-vid="' + escAttr(vid) + '" data-label="' + escAttr(col.name) + '" ' + (avail ? '' : 'disabled ') + 'onclick="bbctSelectVariant(this)">' +
                '<span class="bbct-msz-swatch" style="background:' + col.hex + '"></span>' + escHtml(col.name) + '</button>';
      } else {
        var sz = SIZES[i] || ('Size ' + (i + 1));
        html += '<button class="bbct-msz-btn' + ucls + '" data-vid="' + escAttr(vid) + '" data-label="' + escAttr(sz) + '" ' + (avail ? '' : 'disabled ') + 'onclick="bbctSelectVariant(this)">' + escHtml(sz) + '</button>';
      }
    }

    html += '</div>';
    html += '<button class="bbct-modal-atc" id="bbct-atc-' + sid + '" disabled onclick="bbctAddToCart(\''+ sid + '\')">' + 'Add to Bag</button>';
    html += '<p class="bbct-modal-notice">Free UK delivery on all subscription orders.</p>';

    body.innerHTML = html;
    overlay.dataset.isColour = isColour ? 'true' : 'false';
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  window.bbctSelectVariant = function (btn) {
    var grid = btn.closest('.bbct-msz-grid');
    if (!grid) return;
    grid.querySelectorAll('.bbct-msz-btn').forEach(function (b) { b.classList.remove('selected'); });
    btn.classList.add('selected');
    var overlay = btn.closest('.bbct-modal-overlay');
    if (!overlay) return;
    var sid    = overlay.id.replace('bbct-modal-', '');
    var atcBtn = document.getElementById('bbct-atc-' + sid);
    if (!atcBtn) return;
    atcBtn.disabled = false;
    atcBtn.dataset.selectedVid = btn.dataset.vid || '';
    atcBtn.textContent = 'Add to Bag \u2014 ' + (btn.dataset.label || '');
  };

  window.bbctAddToCart = function (sid) {
    var atcBtn = document.getElementById('bbct-atc-' + sid);
    if (!atcBtn || atcBtn.disabled) return;
    var vid = atcBtn.dataset.selectedVid;
    if (!vid) return;
    atcBtn.disabled    = true;
    atcBtn.textContent = 'Adding\u2026';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: vid, quantity: 1 })
    })
    .then(function (res) { if (!res.ok) throw new Error('Cart error ' + res.status); return res.json(); })
    .then(function () {
      var body    = document.getElementById('bbct-modal-body-' + sid);
      var success = document.getElementById('bbct-modal-success-' + sid);
      if (body)    body.style.display = 'none';
      if (success) success.classList.add('show');
      if (typeof window.Shopify !== 'undefined' && typeof window.Shopify.onCartUpdate === 'function') {
        fetch('/cart.js').then(function (r) { return r.json(); }).then(window.Shopify.onCartUpdate);
      }
    })
    .catch(function (err) {
      console.error('[bbct] Add to cart failed:', err);
      atcBtn.disabled    = false;
      atcBtn.textContent = 'Error \u2014 try again';
    });
  };

  window.bbctClose = function (sid) {
    var overlay = document.getElementById('bbct-modal-' + sid);
    if (!overlay) return;
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', function (e) {
    if (e.target.classList.contains('bbct-modal-overlay')) {
      e.target.classList.remove('open');
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.bbct-modal-overlay.open').forEach(function (o) {
        o.classList.remove('open');
        document.body.style.overflow = '';
      });
    }
  });

  window.bbctMobTab = function (tab, panelId) {
    var tabBar = tab.closest('.bbct-mob-tabs');
    if (tabBar) {
      tabBar.querySelectorAll('.bbct-mob-tab').forEach(function (t) { t.classList.remove('active'); });
      tab.classList.add('active');
    }
    var panels = tab.closest('.bbct-mob').querySelectorAll('.bbct-mob-panel');
    panels.forEach(function (p) { p.classList.remove('active'); });
    var target = document.getElementById(panelId);
    if (target) target.classList.add('active');
  };

  function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function escAttr(str) {
    return String(str).replace(/&/g,'&amp;').replace(/"/g,'&quot;');
  }
})();
</script>
